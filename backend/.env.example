# Cadena de conexion a Supabase (Postgres). La encuentras en Supabase > Project Settings > Database > Connection string (modo "Session pooler" o "URI")
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Clave secreta para firmar JWT (genera una aleatoria, ej: openssl rand -hex 32)
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Credenciales de Adzuna (gratis en https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=mx

# Origenes permitidos para CORS (frontend)
CORS_ORIGINS=http://localhost:5173
